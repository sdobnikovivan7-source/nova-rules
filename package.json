{
  "name": "nova-rules",
  "version": "0.1.0",
  "private": true,
  "description": "Неофициальный справочник правил NOVA RP для Windows",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "author": "Ivan <sdobnikovivan7@gmail.com>",
  "homepage": "https://github.com/sdobnikovivan7-source/nova-rules",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "seed": "tsx --tsconfig tsconfig.node.json scripts/seed.ts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "scrape": "tsx --tsconfig tsconfig.node.json scripts/scrape.ts",
    "fixtures": "tsx --tsconfig tsconfig.node.json scripts/fetch-fixtures.ts",
    "parse-report": "tsx --tsconfig tsconfig.node.json scripts/parse-report.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.59.0",
    "p-retry": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  }
}
